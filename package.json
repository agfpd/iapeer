{
  "name": "@agfpd/iapeer",
  "version": "0.4.73",
  "description": "Run Claude Code and Codex CLI as local background agents that message each other, wake on demand, and share one memory.",
  "license": "Apache-2.0",
  "author": "agfpd",
  "homepage": "https://github.com/agfpd/iapeer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agfpd/iapeer.git"
  },
  "bugs": {
    "url": "https://github.com/agfpd/iapeer/issues"
  },
  "keywords": [
    "claude-code",
    "codex-cli",
    "codex",
    "mcp",
    "shared-memory",
    "peer-to-peer",
    "background-agents",
    "ai-agents",
    "multi-agent",
    "telegram",
    "macos",
    "launchd"
  ],
  "type": "module",
  "bin": {
    "iapeer": "bin/iapeer"
  },
  "files": [
    "src",
    "bin",
    "docs",
    "CHANGELOG.md",
    "tsconfig.json",
    "!src/**/*.test.ts",
    "!docs/internals/**"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./storage": "./src/storage/index.ts",
    "./identity": "./src/identity/index.ts",
    "./registry": "./src/registry/index.ts",
    "./codec": "./src/codec/index.ts"
  },
  "scripts": {
    "test": "IAPEER_TEST_SANDBOX=1 bun test",
    "typecheck": "tsc --noEmit",
    "preversion": "npm run test && npm run typecheck",
    "release": "npm version patch && npm publish && git push origin main --follow-tags",
    "release:minor": "npm version minor && npm publish && git push origin main --follow-tags",
    "release:major": "npm version major && npm publish && git push origin main --follow-tags",
    "prepublishOnly": "test -z \"$(git status --porcelain)\" || (echo 'release: working tree is dirty — commit or stash before release' >&2 && exit 1)"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "ink": "^7.1.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.7",
    "react-devtools-core": "^7.0.1",
    "transliteration": "^2.6.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.17",
    "typescript": "^5.6.0"
  }
}
